{
  "name": "furniture-delivery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "10.34.8"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @furniture-delivery/api --filter @furniture-delivery/web dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @furniture-delivery/api --filter @furniture-delivery/web test",
    "test:integration": "pnpm --filter @furniture-delivery/api test:integration",
    "build": "pnpm -r build",
    "db:migrate": "pnpm --filter @furniture-delivery/api db:migrate",
    "db:seed": "pnpm --filter @furniture-delivery/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.72.0"
  }
}
