# Copy to .env; replace password placeholders with local-only values.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
# Server-only Next.js proxy destination; never prefix private values with NEXT_PUBLIC_.
API_ORIGIN=http://127.0.0.1:3001
# Exact public browser origin checked by NestJS for every unsafe request.
WEB_ORIGIN=http://127.0.0.1:3000
SESSION_TTL_SECONDS=28800
# Omit to default to true in production and false in development/test.
# SESSION_COOKIE_SECURE=false
LOGIN_WINDOW_SECONDS=60
LOGIN_MAX_ATTEMPTS=10
# Supply SEED_PASSWORD locally when creating missing demo accounts. Never commit it.
# SEED_PASSWORD=replace-with-a-local-demo-password

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=furniture_delivery
DATABASE_USER=furniture
DATABASE_PASSWORD=replace-with-your-local-development-password

# Separate PostgreSQL service, port, credentials and database for integration tests.
TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=5433
TEST_DATABASE_NAME=furniture_delivery_test
TEST_DATABASE_USER=furniture_test
TEST_DATABASE_PASSWORD=replace-with-your-local-test-password

# Private persistent local files, outside public/build; omit for workspace uploads/.
# STORAGE_ROOT=/absolute/path/to/private/furniture-uploads
# Limits may be lowered; these values are also their supported maxima.
# STORAGE_IMAGE_MAX_BYTES=10485760
# STORAGE_PDF_MAX_BYTES=20971520
# STORAGE_MAX_PIXELS=40000000
# STORAGE_ORDER_MAX_FILES=100
# STORAGE_ORDER_MAX_BYTES=262144000
